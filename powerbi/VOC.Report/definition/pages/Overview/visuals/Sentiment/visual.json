        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Reviews"
                    }
                  },
                  "Property": "Review count"
                }
              },
              "queryRef": "Reviews.Review count",
              "nativeQueryRef": "Review count"
            }
          ]
        }
      }
